{
  "name": "school-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:hosted": "node scripts/with-env.mjs .env.hosted next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,supavisor,realtime,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:hosted": "node --env-file=.env.hosted scripts/seed.mjs",
    "test": "node --env-file=.env.local --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "supabase@2.120.0": true
  }
}
