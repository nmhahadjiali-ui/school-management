# --- Supabase (Project Settings -> API) --------------------------------------
# Public: safe in the browser. RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never expose to the browser or ship it in the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app; used in auth email links (confirm, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seed script only (npm run seed) -----------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Tests only ----------------------------------------------------------------
# Base URL of a running app for HTTP tests (tests/http.test.mjs).
# TEST_APP_URL=http://localhost:3000
