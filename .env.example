# --- Supabase (Project Settings -> API) --------------------------------------
# Public: safe in the browser. RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never expose to the browser or ship it in the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app; used in auth email links (confirm, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seed script only (npm run seed) -----------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Tests only ----------------------------------------------------------------
# Base URL of a running app for HTTP tests (tests/http.test.mjs).
# TEST_APP_URL=http://localhost:3000

# --- Communication (server only) ----------------------------------------------
# Shared secret for the worker endpoint /api/jobs/communication (cron sends
# "Authorization: Bearer <CRON_SECRET>"). Use a long random value.
CRON_SECRET=
# Delivery providers per channel: "simulator" (dev/test: records sends without
# contacting anyone) or empty (channel not configured). Real vendors are added
# in src/server/notifications/providers.ts with their own *_API_KEY variables.
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
